# Copy this file to .env for local use. Never commit .env.
# On Vercel, add these names under Project -> Settings -> Environment Variables.

# --- Database (TiDB Cloud Starter / hosted MySQL) ---
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your-tidb-user.root
DB_PASSWORD=your-tidb-password
DB_NAME=giex_builders

# DISABLED | REQUIRED | VERIFY_CA | VERIFY_IDENTITY
# Local MySQL: DISABLED. TiDB Cloud: VERIFY_IDENTITY (or REQUIRED).
DB_SSL_MODE=VERIFY_IDENTITY

# Optional CA file / PEM text when the host uses a private CA.
# DB_SSL_CA=certs/ca.pem
# DB_SSL_CA_PEM=-----BEGIN CERTIFICATE-----...

# Session time zone used by CURDATE()/NOW() (Philippines = +08:00).
DB_TIME_ZONE=+08:00

# --- Flask / first administrator ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GIEX_SECRET_KEY=replace-with-a-long-random-value
GIEX_ADMIN_USERNAME=admin
GIEX_ADMIN_PASSWORD=change-this-before-going-live

# --- Optional behavior ---
# GIEX_DB_FLAVOR=tidb          # auto-detected; force it if detection fails
# GIEX_REFRESH_TRIGGERS=1      # MySQL only: recreate the two triggers
# GIEX_HTTPS=1                 # force Secure cookies on a non-Vercel HTTPS host
